# Copiá este archivo como .env y completá los valores.
# .env está en .gitignore: NUNCA lo commitees.

# ── Cliente (navegador) ────────────────────────────────────
# El prefijo VITE_ hace que Vite las incluya en el bundle público.
# Acá va SOLO lo que puede ser público.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# ── Servidor (funciones /api en Vercel) ────────────────────
# SIN prefijo VITE_, para que nunca lleguen al navegador.
# La service_role key saltea RLS: si se filtra, se expone toda la base.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=tu-service-role-key
